\@writefile{toc}{\contentsline {subsection}{\numberline {3.10}Recovery, measured from the first decline}{25}{subsection.3.10}\protected@file@percent }
\newlabel{subsec:recovery}{{3.10}{25}{Recovery, measured from the first decline}{subsection.3.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cumulative share of markets restored to (a) half and (b) 90 percent of baseline dispensing, measured from each market's first crossing below that threshold, with markets never restored censored at the end of follow-up. Shaded bands are Greenwood 95 percent intervals, tick marks denote censoring, and the counts below each panel are the numbers still at risk of restoration, with the entering cohort shown at quarter zero. A market that first crosses the threshold in its last observable quarter has no follow-up and is censored immediately; one\xspace  minority-loss market at the 50 percent threshold and two\xspace  at the 90 percent threshold are in that position and contribute to the entering count but not to the curve. The follow-up a market has is what the panel can show: eight\xspace  markets exited late enough that fewer than twelve quarters follow them, and each is searched and censored over the quarters that exist rather than over twelve. The pointwise bands are wide and overlap, which is worth seeing alongside the log-rank tests rather than in place of them: overlapping pointwise intervals do not contradict a significant log-rank statistic, since the test uses the whole follow-up rather than any single quarter.}}{26}{figure.3}\protected@file@percent }
\newlabel{fig:recovery}{{3}{26}{Cumulative share of markets restored to (a) half and (b) 90 percent of baseline dispensing, measured from each market's first crossing below that threshold, with markets never restored censored at the end of follow-up. Shaded bands are Greenwood 95 percent intervals, tick marks denote censoring, and the counts below each panel are the numbers still at risk of restoration, with the entering cohort shown at quarter zero. A market that first crosses the threshold in its last observable quarter has no follow-up and is censored immediately; \nCensFiftyMinor minority-loss market at the 50 percent threshold and \nCensNinetyMinor at the 90 percent threshold are in that position and contribute to the entering count but not to the curve. The follow-up a market has is what the panel can show: \nTruncHorizon markets exited late enough that fewer than twelve quarters follow them, and each is searched and censored over the quarters that exist rather than over twelve. The pointwise bands are wide and overlap, which is worth seeing alongside the log-rank tests rather than in place of them: overlapping pointwise intervals do not contradict a significant log-rank statistic, since the test uses the whole follow-up rather than any single quarter}{figure.3}{}}
